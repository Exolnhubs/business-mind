EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Web API URL — required for file uploads (avatar, event cover, comment media)
# Production: https://your-app.vercel.app
# Local dev:  http://192.168.x.x:3000  (your machine's LAN IP, not localhost)
EXPO_PUBLIC_API_URL=https://your-app.vercel.app

# Android standalone builds that use react-native-maps require a Google Maps API key.
# iOS uses Apple Maps by default, so this key is only needed for Android map rendering.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-android-key
