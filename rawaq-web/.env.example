# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App URL (used in email links and the DB booking-cancelled trigger)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend — transactional email (https://resend.com)
# Sign up, create an API key, and verify your sending domain.
# For local testing without a domain, use: from=onboarding@resend.dev
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=Rawaq <notifications@yourdomain.com>

# Cron secret — protects /api/cron/event-reminders from public access
# Set the same value as the Authorization: Bearer header in your cron scheduler
CRON_SECRET=your-random-secret-here

# Internal trigger secret — must match app.settings.trigger_secret set in Supabase SQL editor
# ALTER DATABASE postgres SET "app.settings.trigger_secret" = 'same-value-as-below';
INTERNAL_TRIGGER_SECRET=your-trigger-secret-here

# Gemini AI — used for smart event recommendations
# Get your key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# ── Payment Gateways ────────────────────────────────────────────────────────
# Leave all gateway keys empty to use simulated payments (dev/staging default).
# Set at least one real gateway to enable live payments.

# Paymob — Egypt (EGP) primary gateway
# Dashboard: https://accept.paymob.com/portal2/en/settings
# Supports: Card, Fawry (cash), Apple Pay, Google Pay, ValU installments
PAYMOB_API_KEY=
PAYMOB_HMAC_SECRET=              # From: Settings → Account Info → HMAC Secret
PAYMOB_CARD_INTEGRATION_ID=      # From: Accept → Payment Integrations → Online Card
PAYMOB_CARD_IFRAME_ID=           # From: Accept → Payment Integrations → iFrame
PAYMOB_FAWRY_INTEGRATION_ID=     # From: Accept → Payment Integrations → Fawry (optional)
PAYMOB_APPLE_PAY_INTEGRATION_ID= # From: Accept → Payment Integrations → Apple Pay (optional)
PAYMOB_GOOGLE_PAY_INTEGRATION_ID=# From: Accept → Payment Integrations → Google Pay (optional)
PAYMOB_VALU_INTEGRATION_ID=      # From: Accept → Payment Integrations → ValU (optional)

# Stripe — International gateway (SAR, USD, EUR, GBP, …)
# Dashboard: https://dashboard.stripe.com/apikeys
# Supports: Card, Apple Pay, Google Pay (automatic in Stripe Checkout)
STRIPE_SECRET_KEY=               # sk_live_... or sk_test_...
STRIPE_WEBHOOK_SECRET=           # whsec_... from: Developers → Webhooks → endpoint signing secret
STRIPE_INSTALLMENT_ENABLED=false # Set to 'true' to enable installment plans where available

# Stripe webhook endpoint to register in Stripe Dashboard:
#   https://your-app.vercel.app/api/webhooks/stripe
# Events to listen for:
#   checkout.session.completed
#   checkout.session.async_payment_failed

# Paymob webhook URL to register in Paymob Dashboard:
#   https://your-app.vercel.app/api/webhooks/paymob
#   Accept → Settings → Transaction processed callback → set URL above
