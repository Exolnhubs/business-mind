# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Push notifications (Firebase FCM)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# AI (Google Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FALLBACK_MODELS=

# Payments (Paymob)
PAYMOB_BASE_URL=https://accept.paymobsolutions.com
PAYMOB_SECRET_KEY=
NEXT_PUBLIC_PAYMOB_PUBLIC_KEY=
PAYMOB_CHECKOUT_URL_TEMPLATE=https://accept.paymob.com/unifiedcheckout/?publicKey={publicKey}&clientSecret={clientSecret}
PAYMOB_HMAC_SECRET=
PAYMOB_CARD_INTEGRATION_ID=
PAYMOB_FAWRY_INTEGRATION_ID=
PAYMOB_APPLE_PAY_INTEGRATION_ID=
PAYMOB_GOOGLE_PAY_INTEGRATION_ID=
PAYMOB_VALU_INTEGRATION_ID=

# Payments (Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Rate limiting (Upstash Redis) — required, app will crash on cold start without these
# Create a free database at https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cron
CRON_SECRET=

# Used to protect internal API routes that are called by the DB trigger (e.g. booking-cancelled). Set this to a random string and use the same value in the trigger function.
INTERNAL_TRIGGER_SECRET=

# Error monitoring (Sentry)
SENTRY_AUTH_TOKEN=
SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
